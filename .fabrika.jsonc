// Fabrika configuration for fabrika-tuval
{
	"$schema": "./.fabrika.schema.json",

	// Project metadata
	"project": {
		"name": "fabrika-tuval",
		"description": "Fabrika: deterministic build and deployment system"
	},

	// Governed roots — paths that fabric fabric enforces
	"governedRoots": [".decisions/", ".claude/", ".github/", ".fabrika.jsonc"],

	// Repository names used in portability checks
	"portability": {
		"repoNames": ["fabrika-tuval", "kamp-us"]
	},

	// Board vocabulary for issue lanes
	"boardVocabulary": {
		"standingLanes": []
	},

	// Lane concurrency cap
	"laneConcurrencyCap": 2,

	// Assembly configuration
	"assemblyRefresh": {
		"onReview": "on",
		"onDispatch": "on"
	},
	"assemblyReplay": {
		"onCollision": "on"
	},
	"machineryLaps": {
		"onEmit": "on"
	},
	"parkCause": {
		"uncaused": "refuse",
		"driverRouted": "clear"
	},

	// Build commands for code surface checks
	"buildCommands": {
		"typecheck": "pnpm typecheck",
		"lint": "pnpm lint"
	},

	// Deployed applications
	"apps": {
		"goal-hedef": {
			"path": "apps/goal-hedef",
			"description": "Goal & habit tracking canvas application",
			"commands": {
				"dev": "pnpm dev",
				"build": "pnpm build",
				"typecheck": "pnpm typecheck"
			}
		}
	},

	// Default app (when no app specified in command)
	"defaultApp": "goal-hedef",

	// Doc leak exemptions — paths that the gate allows despite matching leak patterns
	"docLeakExempt": [
		"/CLAUDE.md",
		"/agents/triager.md",
		"/packages/leak-guard/README.md",
		"/skills/report/SKILL.md",
		"/skills/review-doc/SKILL.md",
		"/skills/skill-doctor/references/supported-harnesses.md",
		"/skills/triage/SKILL.md"
	],

	// Control plane gate configuration
	"unreadableCodeowners": "refuse"
}
