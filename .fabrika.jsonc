// fabrika's config for this repo. Every key is optional: one you leave out takes its shipped default.
// `fabrika status settings` prints what every key resolves to and where the value came from.
{
	// The commands that compile and lint this repo's code. While this list is empty,
	// `fabrika build check --surface code` and `fabrika lane integrate` refuse.
	"codeValidators": [{ "command": ["pnpm", "typecheck"] }, { "command": ["pnpm", "lint"] }],

	// The command that installs what the lockfile pins. Without it, `fabrika lane integrate` skips
	// the install, so a change that moves the lockfile is checked against the old install.
	"dependencyReconciler": { "command": ["pnpm", "install", "--frozen-lockfile"] },

	// The app this repo renders. The prefix makes a change under it a screen change, and the command
	// lets `fabrika ui render` start the app on a free port.
	"uiSurfaces": [
		{
			"name": "goal-hedef",
			"prefix": "apps/goal-hedef/src/",
			"mount": "/",
			"command": "pnpm --filter @hedef/goal-hedef-canvas dev --port {{port}} --strictPort"
		}
	],

	"ci": {
		// The workflow that runs lint, typecheck and build on every pull request.
		"gateWorkflow": "pull-request.yml"
	},

	// Allow shipping from main working tree (single-seat development)
	"shipScope": { "mainWorkingTree": "allow" },

	// The PR previews this repo deploys post no fabrika `preview-deploy` comment, so the reviewer has
	// no hosted copy to open. A screen change waits for an owner's screenshots on the PR instead.
	"reviewUi": {
		"mode": "hand-check"
	},

	// A lane that has to stop for a reason no park cause names still stops and comes to you,
	// instead of being refused and left where it was.
	"parkCause": { "uncaused": "record" },

	// This repo has no standing lanes: every issue homes on a milestone.
	"boardVocabulary": { "standingLanes": [] }
}
